# Variabili usate dal bot. Copia in .env e compila SOLO sul computer che fa girare il bot.
# Mai committare il .env vero.
DESK_PAPER_ONLY=1          # 1 = solo paper (obbligatorio finche il live non e approvato)
DESK_HEADLESS=1
DESK_WEB_HOST=127.0.0.1
DESK_WEB_PORT=
GMGN_API_KEY=              # chiave personale da gmgn.ai/ai
GMGN_INTERVAL=
GMGN_POLL_SEC=
FOMOAPI_KEY=
FOMO_DAILY_CAP=
FOMO_POLL_SEC=
FOMO_SUB_POLL_SEC=
JUP_API_KEY=
KOL_RPC=                   # URL RPC Solana (puo contenere una chiave)
KOL_INCLUDE_PROPOSED=0
PRIVATE_KEY=               # chiave del wallet: SOLO per il live, mai qui nel repo
PERP_PAPER_ONLY=1
PERP_LIVE_CONFIRM=
